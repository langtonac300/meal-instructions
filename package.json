{
  "name": "dad-meals-no-fluff",
  "version": "1.0.0",
  "private": true,
  "bin": {
    "dadmeals-mcp": "./bin/dadmeals-mcp.mjs"
  },
  "scripts": {
    "dev": "npm run build:content && next dev",
    "build:content": "node scripts/build-recipes.mjs",
    "validate:recipes": "node scripts/validate-recipes.mjs",
    "build": "npm run build:content && npm run validate:recipes && next build",
    "start": "next start",
    "lint": "next lint",
    "mcp": "tsx bin/dadmeals-mcp.ts",
    "test:mcp": "tsx scripts/test-mcp.ts",
    "audit:content": "node scripts/audit-content.mjs",
    "audit:seo": "node scripts/audit-seo.mjs",
    "gaps": "node scripts/content-gaps.mjs",
    "ship": "./scripts/ship-content.sh",
    "daily-content": "node scripts/daily-routine.mjs",
    "routine": "node scripts/daily-routine.mjs",
    "deploy:status": "node scripts/daily-routine.mjs --status"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3"
  }
}
