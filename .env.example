# Dad Meals Environment Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Dad Meals // Zero Fluff"

# ─── Auth.js (Google OAuth) ───
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# From Google Cloud Console → Credentials → OAuth 2.0 Client
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Supabase (meals_* tables — saved meals, ratings, edit suggestions) ───
# Optional. When unset, Google sign-in still works; the save/rate/suggest
# block and /account are hidden. Project: red-flag-agency.
SUPABASE_URL=https://obsihtlfijkmctpzddsb.supabase.co
# Service role key — server-only, bypasses RLS. Dashboard → Project Settings
# → API → service_role. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
