# Dad Meals Environment Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Auth.js (Google OAuth) ───
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# From Google Cloud Console → Credentials → OAuth 2.0 Client
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Supabase (meals_* tables — saved meals, ratings, edit suggestions) ───
# Optional. When unset, Google sign-in still works; the save/rate/suggest
# block and /account are hidden. Project: red-flag-agency.
SUPABASE_URL=https://obsihtlfijkmctpzddsb.supabase.co
# Service role key — server-only, bypasses RLS. Dashboard → Project Settings
# → API → service_role. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Android TWA (Play Store app — see ANDROID.md) ───
# Digital Asset Links. Without these the Android app renders with a visible
# browser address bar. Comma-separated SHA-256 fingerprints, "AA:BB:..:FF" form:
# list BOTH the Play App Signing key and your local upload key.
# Play Console → Setup → App integrity → App signing key certificate.
ANDROID_PACKAGE_NAME=com.mealinstructions.twa
ANDROID_ASSETLINKS_FINGERPRINTS=
