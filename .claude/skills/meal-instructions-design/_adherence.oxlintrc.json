        "selector": "JSXOpeningElement[name.name='LeanIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|base|key|ref|className|style|children)$/]",
        "message": "<LeanIcon> doesn't accept that prop. Declared props: name, size, base."
