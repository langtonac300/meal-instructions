        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|padding|rounded|shadow|hover|verified|as|children|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: variant, padding, rounded, shadow, hover, verified, as, children."
