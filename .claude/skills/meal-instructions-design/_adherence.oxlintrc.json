      },
      {
        "selector": "JSXOpeningElement[name.name='LeanSpecBadge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:cell|row|inline|compact)$/]",
        "message": "<LeanSpecBadge> variant must be one of 'cell' | 'row' | 'inline' | 'compact'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|variant|inverse|className|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: size, variant, inverse, className, style."
      },
