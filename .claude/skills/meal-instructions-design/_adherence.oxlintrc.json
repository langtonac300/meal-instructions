        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|rounded|bold|icon|href|as|children|key|ref|className|style|children)$/]",
        "message": "<Pill> doesn't accept that prop. Declared props: variant, size, rounded, bold, icon, href, as, children."
