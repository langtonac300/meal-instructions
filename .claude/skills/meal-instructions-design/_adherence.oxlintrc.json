{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/**",
              "components/core/**",
              "components/discovery/**",
              "components/navigation/**",
              "components/recipe/**",
              "ui_kits/web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|rounded|icon|iconRight|iconSize|iconOnly|href|as|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, rounded, icon, iconRight, iconSize, iconOnly, href, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ink|accent|outline|outline-muted|card|paper|ghost|caution|inset)$/]",
        "message": "<Button> variant must be one of 'ink' | 'accent' | 'outline' | 'outline-muted' | 'card' | 'paper' | 'ghost' | 'caution' | 'inset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryMeta'] > JSXAttribute > JSXIdentifier[name!=/^(?:slug|name|heroTag|image|count|key|ref|className|style|children)$/]",
        "message": "<CategoryMeta> doesn't accept that prop. Declared props: slug, name, heroTag, image, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConsentBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:onDecide|fixed|className|style|key|ref|className|style|children)$/]",
        "message": "<ConsentBanner> doesn't accept that prop. Declared props: onDecide, fixed, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CrisisPreset'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|title|subtitle|category|maxMinutes|key|ref|className|style|children)$/]",
        "message": "<CrisisPreset> doesn't accept that prop. Declared props: id, title, subtitle, category, maxMinutes."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:categories|appliances|datasheetCount|onNavigate|className|style|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: categories, appliances, datasheetCount, onNavigate, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|fill|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, fill."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kbd'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Kbd> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CookTimeDatasheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|slug|food|foodSlug|appliance|state|cutOrPrep|tempF|tempC|tempFormatted|timeFormatted|timeMinMinutes|timeMaxMinutes|flipAtMinutes|internalTempTargetF|internalTempTargetFormatted|restMinutes|oilSprayRequired|donenessCue|verificationBasis|proTip|relatedRecipeSlug|key|ref|className|style|children)$/]",
        "message": "<CookTimeDatasheet> doesn't accept that prop. Declared props: id, slug, food, foodSlug, appliance, state, cutOrPrep, tempF, tempC, tempFormatted, timeFormatted, timeMinMinutes, timeMaxMinutes, flipAtMinutes, internalTempTargetF, internalTempTargetFormatted, restMinutes, oilSprayRequired, donenessCue, verificationBasis, proTip, relatedRecipeSlug."
      },
      {
        "selector": "JSXOpeningElement[name.name='KitchenTimer'] > JSXAttribute > JSXIdentifier[name!=/^(?:initialMinutes|label|autoStart|onClose|fixed|className|style|key|ref|className|style|children)$/]",
        "message": "<KitchenTimer> doesn't accept that prop. Declared props: initialMinutes, label, autoStart, onClose, fixed, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Lean5SMatrix'] > JSXAttribute > JSXIdentifier[name!=/^(?:cookTemp|totalMinutes|proteinGrams|internalTemp|flipMinutes|restMinutes|servings|className|style|key|ref|className|style|children)$/]",
        "message": "<Lean5SMatrix> doesn't accept that prop. Declared props: cookTemp, totalMinutes, proteinGrams, internalTemp, flipMinutes, restMinutes, servings, className, style."
