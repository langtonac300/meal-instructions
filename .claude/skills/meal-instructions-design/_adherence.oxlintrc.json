        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<Logo> size must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:mark-only|horizontal|stacked)$/]",
        "message": "<Logo> variant must be one of 'mark-only' | 'horizontal' | 'stacked'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MealActions'] > JSXAttribute > JSXIdentifier[name!=/^(?:recipeTitle|signedIn|saved|stars|onSignIn|onSave|onRate|onSuggest|className|style|key|ref|className|style|children)$/]",
        "message": "<MealActions> doesn't accept that prop. Declared props: recipeTitle, signedIn, saved, stars, onSignIn, onSave, onRate, onSuggest, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MicroLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|dot|pulse|note|as|key|ref|className|style|children)$/]",
        "message": "<MicroLabel> doesn't accept that prop. Declared props: children, color, dot, pulse, note, as."
